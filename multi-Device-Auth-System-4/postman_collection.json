    {
      "name": "2. Multi-Device Session Management",
      "item": [
        {
          "name": "2.1 View All Active Devices",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var json = pm.response.json();",
                  "pm.test('Returns sessions array', function () {",
                  "    pm.expect(json.sessions).to.be.an('array');",
                  "    pm.expect(json.sessions.length).to.be.at.least(1);",
                  "});",
                  "var remote = json.sessions.find(s => !s.isCurrentDevice);",
                  "if (remote) {",
                  "    pm.collectionVariables.set('remoteSessionId', remote.sessionId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sessions"]
            }
          }
        },
        {
          "name": "2.2 Revoke Specific Device (Remote Logout)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sessions/{{remoteSessionId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sessions", "{{remoteSessionId}}"]
            }
          }
        },
        {
          "name": "2.3 Verify Device List (After Single Revocation)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sessions"]
            }
          }
        },
        {
          "name": "2.4 Logout Current Device",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "logout"]
            }
          }
        },
        {
          "name": "2.5 Revoke All Devices (Logout Everywhere)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "sessions"]
            }
          }
        }
      ]
