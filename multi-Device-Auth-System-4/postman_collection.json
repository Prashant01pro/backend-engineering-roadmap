  "item": [
    {
      "name": "1. Authentication & Device Login",
      "item": [
        {
          "name": "1.1 Register User (Chrome Laptop)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.accessToken) pm.collectionVariables.set('accessToken', json.accessToken);",
                  "    if (json.sessionId) pm.collectionVariables.set('sessionId', json.sessionId);",
                  "    pm.test('Registration returns 201 and tokens', function () {",
                  "        pm.expect(json.accessToken).to.be.a('string');",
                  "        pm.expect(json.sessionId).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "User-Agent",
                "value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Prashant Kumar\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password@1234\",\n  \"bio\": \"Full-Stack Software Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "register"]
            }
          }
        },
        {
          "name": "1.2 Login Device 1 (Chrome Laptop)",
