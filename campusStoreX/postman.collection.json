              "raw": "{{baseUrl}}/api/v1/cart/items",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cart", "items"]
            }
          }
        },
        {
          "name": "8.2 Checkout Order (ACID Pipeline)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    var json = pm.response.json();",
                  "    if (json.data && json.data.order && json.data.order._id) {",
                  "        pm.collectionVariables.set('orderId', json.data.order._id);",
                  "    }",
                  "    pm.test('Order checked out with snapshot items', function () {",
                  "        pm.expect(json.data.order.status).to.equal('COMPLETED');",
                  "        pm.expect(json.data.order.items[0].price).to.be.a('number');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders/checkout",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders", "checkout"]
            }
          }
