NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database & Cache
MONGO_URI=mongodb://127.0.0.1:27017/orchestrix
REDIS_URI=redis://127.0.0.1:6379

# Hybrid Auth Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_at_least_16_chars
REFRESH_TOKEN_SECRET=your_refresh_token_secret_at_least_16_chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Cloudinary Cloud Storage (Profile Images)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email (Nodemailer SMTP)
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=NexusFlow OrchestriX <your_email@gmail.com>

HOCUSPOCUS_PORT=5464

# Frontend Client
FRONTEND_URL=http://localhost:5173